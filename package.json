{
  "name": "7741-green-lake-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted home-for-sale showcase for 7741 1st Avenue NE.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:cloudflare": "node scripts/build.mjs --cloudflare",
    "deploy": "npm run build:cloudflare && node scripts/deploy-cloudflare.mjs",
    "preview": "node scripts/serve.mjs dist",
    "media": "node scripts/prepare-media.mjs",
    "promotion": "node scripts/prepare-promotion.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "jsdom": "^30.0.1",
    "pdfjs-dist": "^6.3.289",
    "sharp": "^0.35.4",
    "wrangler": "^4.134.0"
  }
}
