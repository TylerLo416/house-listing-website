{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "7741greenlake",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/assets/video/*"]
  },
  "r2_buckets": [
    { "binding": "VIDEOS", "bucket_name": "property-videos" }
  ]
}
